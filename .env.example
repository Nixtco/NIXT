# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3003/api/v1

# WebSocket URL (for real-time chat)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Production WebSocket URL (uncomment for production with SSL)
# NEXT_PUBLIC_WS_URL=wss://your-domain.com

# Google OAuth Client ID (optional - for Google login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Notes:
# - Make sure backend is running on port 8080 for WebSocket
# - Use wss:// (secure WebSocket) in production
# - Copy this file to .env.local and fill in the values
